# 复制为 .env 后填写。SECRET_KEY 等敏感项勿提交仓库。

# ===== App security =====
# 生成: openssl rand -hex 32（更换后已签发的 JWT 会失效；存量加密数据需保留原密钥或单独设 API_KEY_ENCRYPTION_KEY）
SECRET_KEY=
# 本地开发可设为 true；生产务必 false。仅 DEBUG=true 时允许 Header token=dev 免 JWT
DEBUG=false
DEBUG_AGENT_KB_PROMPT=false
# 首次启动且库中无用户时创建的管理员（密码勿提交仓库；至少 8 位且含字母与数字）
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
# 是否开放邮箱自助注册（本机开发可 true；公网务必 false）
ALLOW_PUBLIC_REGISTRATION=true
# 本机调试 MCP / 内网模型时才设 true
ALLOW_PRIVATE_UPSTREAM_URLS=false
# 用户可配置上游出站默认钉死校验解析所得 IP；仅排障时临时关闭
EGRESS_PIN_DNS=true
# 生产设 false，关闭 /docs /redoc /openapi.json
DOCS_ENABLED=true
# uvicorn 监听；公网请保持 127.0.0.1 并放在反代后
UVICORN_HOST=127.0.0.1
# 公网建议保持默认 15 分钟 access；刷新令牌为 HttpOnly cookie（7 天）
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# HTTPS 生产设 true；本机 http 可 false
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax
# 仅在可信反向代理之后设 true
AUTH_TRUST_X_FORWARDED_FOR=false
# 生产建议单独设置 Fernet 密钥：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 未设置时由 SECRET_KEY 派生。轮换 SECRET_KEY 后需保留原派生密钥才能解密存量 API Key
API_KEY_ENCRYPTION_KEY=
# CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]

# ===== 对话安全（默认值见 app/settings/config.py，一般无需修改）=====
# 对话生成接口按用户限流（次/分钟，0=关闭）
# CHAT_RATE_LIMIT_PER_MINUTE=20
# 单条用户消息字符上限
# CHAT_MESSAGE_MAX_LENGTH=8000
# ===== 会话存储瘦身与配额（防滥用 / 防库膨胀）=====
# content 预览列字符上限（完整正文在 content_json，预览仅用于列表/展示）
# CHAT_MESSAGE_PREVIEW_CHARS=2000
# 单条助手消息附加 JSON 字符上限与各列表长度上限（超出丢调试字段/截断列表）
# CHAT_EXTRA_JSON_MAX_CHARS=8000
# CHAT_RAG_STEPS_MAX=50
# CHAT_THINKING_ITEMS_MAX=200
# CHAT_SOURCES_MAX=50
# 同一轮重新生成最多保留的助手版本数（超出淘汰最旧，0=不限）
# CHAT_MAX_ASSISTANT_VERSIONS=5
# 每用户每智能体会话数上限 / 每会话消息行上限（0=不限）
# CHAT_MAX_SESSIONS_PER_USER_AGENT=200
# CHAT_MAX_MESSAGES_PER_SESSION=4000
# 闲置会话留存天数（0=关闭；开启后用 scripts/purge_idle_sessions.py 清理，支持 dry-run）
# CHAT_SESSION_RETENTION_DAYS=0
# CHAT_SESSION_RETENTION_BATCH=200
# 共享（非属主）会话是否允许加载属主 MCP 工具；true 会让共享用户可驱动属主凭据，务必保持 false
# SHARE_CHAT_ALLOW_OWNER_MCP_TOOLS=false
# 注入模型前的非可信外部内容（知识库/网页检索结果）字符上限
# TOOL_UNTRUSTED_CONTENT_MAX_CHARS=16000
# 单个 MCP 工具返回内容字符上限
# MCP_TOOL_RESULT_MAX_CHARS=8000
# 高危/写操作 MCP 工具执行前确认（生产建议 true）
# MCP_CONFIRMATION_REQUIRED=true
# MCP_CONFIRMATION_TTL_SECONDS=300
# MCP_CONFIRMATION_MAX_PER_TURN=3
# MCP_HIGH_RISK_TOOL_PATTERNS=["create","update","delete","merge","commit","push","release","publish","send","write"]

# ===== Embedding Model (多模态) =====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3-vl-embedding
# 向量维度，须与 Milvus 集合 dense_embedding 维一致；qwen3-vl-embedding 为 1536
EMBEDDING_DIM=1536
# 嵌入 API 每批条数
EMBEDDING_BATCH_SIZE=10

# ===== Rerank Model（知识库重排，DashScope qwen3-vl-rerank，多模态；留空则跳过 rerank）=====
RERANK_MODEL=qwen3-vl-rerank
RERANK_API_KEY=
RERANK_BINDING_HOST=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 图片块是否参与多模态重排
RERANK_INCLUDE_IMAGES=true
# Rerank 分数阈值：最高 relevance_score 低于该值时按「知识库无相关资料」处理；注释掉=禁用
# RERANK_MIN_SCORE=0.2

# ===== 实验平台端到端问答评测（生成 + LLM 判分；仅超管实验模块使用）=====
# 留空时 base_url/api_key 分别回落 EMBEDDING_BASE_URL / EMBEDDING_API_KEY
# EXP_EVAL_LLM_BASE_URL=
# EXP_EVAL_LLM_API_KEY=
EXP_EVAL_ANSWER_MODEL=qwen-plus
# 判分模型；注释掉则与 EXP_EVAL_ANSWER_MODEL 相同
# EXP_EVAL_JUDGE_MODEL=
# EXP_EVAL_TEMPERATURE=0
# 送入生成的资料总字符上限 / 答案字符上限
# EXP_EVAL_MAX_CONTEXT_CHARS=12000
# EXP_EVAL_MAX_ANSWER_CHARS=4000
# 可选 LangSmith 导出（仅手动触发；未配置 API Key 时导出接口不可用）
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=kura-ai-experiment

# ===== 知识库上传/处理（可选，默认值如下）=====
# 单个文档处理整体时长上限（秒），超时中止、旧文档保留
KB_UPLOAD_TASK_TIMEOUT_SECONDS=900
# 单次嵌入 API 调用 HTTP 超时（秒）
KB_UPLOAD_EMBEDDING_HTTP_TIMEOUT_SECONDS=90
# 同时并行处理的文档数上限，超出排队（KB_UPLOAD_MODE=inline 时生效）
KB_UPLOAD_MAX_PARALLEL=8
# 受理模式：queue=独立 worker 进程消费（生产推荐，docker-compose.prod.yml 已自动设为 queue）；
# inline=API 进程线程池（本地开发默认，无需启动 worker）
KB_UPLOAD_MODE=inline
# 独立 worker 的处理线程数（KB_UPLOAD_MODE=queue 时生效）
KB_WORKER_THREADS=4
# 队列后端：kafka=Kafka 主题（docker-compose.prod.yml 会覆盖为 kafka）；
# stream=Redis Stream 消费者组（回滚：按消息 ack + 超时回收 + 投递计数 + 死信）；
# list=旧 List + processing 可靠队列（回滚通道）。切换前先停写入并等 worker 排空。
# 本地默认 inline，不连接 Kafka。本机改走队列：MODE=queue、BACKEND=kafka，并另起 python worker.py
KB_UPLOAD_QUEUE_BACKEND=stream
# 容器内 broker 为 kafka:9092；本机进程连 compose 映射的 127.0.0.1:9094
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
KAFKA_UPLOAD_TOPIC=kb-upload-jobs
KAFKA_UPLOAD_DEAD_TOPIC=kb-upload-dead
# 分区数须 ≥ KB_WORKER_THREADS × kb-worker 副本数，否则多余线程分不到分区
KAFKA_UPLOAD_PARTITIONS=16
# Stream 名 / 消费者组名 / 死信 stream 名（多副本共用同一消费者组实现负载均衡）
KB_UPLOAD_STREAM_KEY=kb_upload_job:stream
KB_UPLOAD_CONSUMER_GROUP=kb_upload_workers
KB_UPLOAD_DEAD_STREAM=kb_upload_job:dead
# 单任务最大投递次数：超过后判失败并转死信，避免坏任务无限重投
KB_UPLOAD_MAX_DELIVERIES=3
# Stream 出队阻塞毫秒数；超时任务回收扫描间隔（秒，配合 KB_UPLOAD_STALE_SECONDS 阈值）
KB_UPLOAD_READ_BLOCK_MS=3000
KB_UPLOAD_RECLAIM_INTERVAL_SECONDS=60
# 全局排队 + 处理中任务数上限（0=不限制）；入队为原子检查，超限上传接口返回 429 让用户稍后重试
KB_UPLOAD_QUEUE_MAX=2000
# 单用户活动任务（排队 + 处理中）上限（0=不限制）
KB_UPLOAD_USER_MAX_ACTIVE=600
# 用户活动任务集合 TTL（秒）：worker 崩溃未清理的陈旧计数自动过期
KB_UPLOAD_USER_ACTIVE_TTL_SECONDS=7200
# worker 崩溃回收阈值（秒）：processing 中任务心跳超过该时长才会被重投/判死
KB_UPLOAD_STALE_SECONDS=900
# 上传文件大小上限 50MB
KB_UPLOAD_MAX_BYTES=52428800
# 嵌入调用被限流/网络抖动时的自动重试次数（指数退避 + 抖动，0 表示不重试）
KB_UPLOAD_EMBEDDING_MAX_RETRIES=3
# 重试退避基数与上限（秒）
KB_UPLOAD_EMBEDDING_RETRY_BASE_SECONDS=1.0
KB_UPLOAD_EMBEDDING_RETRY_MAX_SECONDS=8.0
# 全局并发调用嵌入 API 的上限（跨所有上传线程共享），降低触发服务商限流的概率
EMBEDDING_MAX_CONCURRENCY=4
# 等待嵌入并发额度的最长时间（秒）
EMBEDDING_CONCURRENCY_WAIT_SECONDS=120
# 同名文档替换锁等待上限（秒）：超时失败提示稍后重试（替代无界自旋）
# KB_UPLOAD_SWAP_LOCK_WAIT_SECONDS=3
# 上传进度上报节流：最小间隔（秒）与最小百分比增量（二者同时不满足才跳过写）
# KB_PROGRESS_MIN_INTERVAL_SECONDS=0.5
# KB_PROGRESS_MIN_PERCENT_STEP=2
# 文本/源码文件解析读取上限（字节）：超过截断解析，避免超大文本整份进内存
# KB_TEXT_FILE_MAX_BYTES=20971520

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=kura_ai_kb
# 连接建立超时（秒）：Milvus 不可达时避免无限挂起（探活/启动预热）
# MILVUS_CONNECT_TIMEOUT_SECONDS=5
# 探活/轻量查询 RPC 超时（秒）
# MILVUS_PROBE_TIMEOUT_SECONDS=5

# ===== Database / Cache =====
# docker-compose 无弱默认口令：必须设置 POSTGRES_PASSWORD（已有 volume 不会因改此项而改库内密码）
POSTGRES_USER=postgres
POSTGRES_DB=langchain_app
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5433/langchain_app
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 对象存储（MinIO / S3 兼容；用户头像、会话附件、知识库文档与图片）=====
# 开发指向本机 docker-compose 的 minio-app 容器（127.0.0.1:9002）；生产 compose 内自动覆盖为 minio-app:9000
S3_ENDPOINT=127.0.0.1:9002
S3_ACCESS_KEY=kura_app
# 生产务必修改；须与 MINIO_APP_ROOT_PASSWORD 一致
S3_SECRET_KEY=kura_app_dev_only_change_me
S3_BUCKET=kura-user-files
S3_SECURE=false
# minio-app 容器 root 账号（docker-compose.yml 引用，无弱默认）
MINIO_APP_ROOT_USER=kura_app
MINIO_APP_ROOT_PASSWORD=kura_app_dev_only_change_me

# 已开鉴权的 Milvus / Zilliz 可填 token；本地 docker standalone 通常留空
# MILVUS_TOKEN=

# ===== 上下文管理（短期记忆：token 预算 + 分段摘要压缩）=====
# 智能体未单独配置 context_window 时使用的模型上下文窗口（token）
# CHAT_MODEL_CONTEXT_WINDOW_DEFAULT=128000
# 触发点 = 窗口 - 摘要输出预留 - 安全缓冲（对齐 Claude Code 的「距上限固定缓冲」）
# CHAT_COMPACT_SUMMARY_RESERVE_TOKENS=8000
# CHAT_COMPACT_BUFFER_TOKENS=6000
# 压缩后保留的最近原文 token 数
# CHAT_COMPACT_KEEP_TOKENS=8000
# 摘要正文上限（字符）与喂给摘要器的被移出对话 token 上限（超出丢最旧、保最新）
# 压缩在请求内同步执行，该上限越小单次摘要越快（用户可感知的停顿越短）
# CHAT_COMPACT_SUMMARY_MAX_CHARS=8000
# CHAT_COMPACT_SUMMARIZER_INPUT_TOKENS=24000
# 分段摘要数/总 token 超限时，本次压缩顺带把旧链归并为更粗粒度的一段
# CHAT_COMPACT_MAX_SEGMENTS=8
# CHAT_COMPACT_SEGMENTS_TOKEN_BUDGET=4000
# 连续失败该次数后熔断，降级为硬截断不再调 LLM（成功后清零）
# CHAT_COMPACT_MAX_CONSECUTIVE_FAILURES=3
# 启发式估算系数，会被上一轮真实 usage_metadata 自动校准覆盖
# CHAT_TOKENS_PER_CJK_CHAR=1.0
# CHAT_CHARS_PER_LATIN_TOKEN=3.6

# ===== 轮内 micro-compact：清理旧的、可重新获取的工具结果 =====
# 该闸门同时用于压缩前预处理：先零成本清理，再判断是否真的需要付 LLM 摘要
# CHAT_MICROCOMPACT_ENABLED=true
# CHAT_MICROCOMPACT_KEEP_RECENT=5
# CHAT_MICROCOMPACT_TRIGGER_RATIO=0.6
# CHAT_MICROCOMPACT_MAX_RESULT_TOKENS=6000

# ===== 会话原文翻牌工具 read_session_history =====
# CHAT_HISTORY_TOOL_MAX_CALLS=2

# ===== 跨会话用户长期记忆（PostgreSQL 存储，无向量库/embedding）=====
# 模型通过 read/save/forget_user_memory 工具按需读写，不在压缩摘要阶段自动抽取
# CHAT_USER_MEMORY_ENABLED=true
# CHAT_MEMORY_FACT_MAX_CHARS=600
# 每用户每智能体的条数上限，超出按 updated_at 删最旧
# CHAT_MEMORY_USER_FACT_MAX=500
# 同一轮内 save_user_memory 最多成功写入条数
# CHAT_MEMORY_WRITE_MAX_PER_TURN=3
# read_user_memory 一次最多返回条数 / 工具返回 token 预算
# CHAT_MEMORY_READ_MAX_ITEMS=50
# CHAT_MEMORY_TOOL_MAX_TOKENS=3000

# 已弃用的会话记忆 Milvus 集合（kura_ai_chat_memory）可一次性删除：
#   python scripts/drop_chat_memory_collection.py --yes

# LLM HTTP 超时（秒）与进程内同时进行的对话 Job 上限
# LLM_HTTP_CONNECT_TIMEOUT=10
# LLM_HTTP_READ_TIMEOUT=120
# LLM_HTTP_WRITE_TIMEOUT=30
# LLM_HTTP_POOL_TIMEOUT=10
# LLM_MAX_INFLIGHT=8
# RAG_ALLOW_COMPLEX_STRATEGY=false
# RAG_STEP_BACK_ANSWER_ENABLED=false

# ===== 并发与上游配额保护（按部署规模调整；多副本时闸门数据按副本数分摊）=====
# 事件循环默认线程池：asyncio.to_thread 与 LangChain 同步工具共享（100 并发活跃建议 96）
# DEFAULT_EXECUTOR_MAX_WORKERS=96
# 工具长任务并发闸门：防止 RAG/搜索等分钟级同步工具占满默认线程池
# TOOL_MAX_INFLIGHT=24
# 同一 base_url 的 LLM httpx 连接池上限（需与上游配额匹配）
# LLM_HTTP_MAX_CONNECTIONS=64
# LLM_HTTP_MAX_KEEPALIVE=16

# 嵌入/重排上游全局配额（Redis 闸门，跨 API 副本与 kb-worker 共享）。
# 个人账号配额有限时保持保守值，压测中以 429 率 <1% 为准逐步调高。
# EMBEDDING_GLOBAL_CONCURRENCY=2
# EMBEDDING_GLOBAL_QPS=2
# RERANK_GLOBAL_CONCURRENCY=2
# RERANK_GLOBAL_QPS=2
# 配额等待上限（秒）：快速降级模式下应远小于上游超时
# UPSTREAM_QUOTA_WAIT_SECONDS=8
# 熔断：连续失败达到阈值后短路该上游，冷却后放行探测
# UPSTREAM_BREAKER_FAILS=3
# UPSTREAM_BREAKER_OPEN_SECONDS=60
# 通用上游重试退避上限（秒）：低配额场景缩短卡顿
# UPSTREAM_RETRY_MAX_SECONDS=1.5
# 检索链路单次嵌入 HTTP 超时（秒）：勿用 SDK 默认（可达 300s）
# EMBEDDING_RETRIEVE_TIMEOUT_SECONDS=20
# 查询向量 Redis 缓存 TTL（秒）：相同 query 零上游调用
# EMBEDDING_QUERY_CACHE_TTL_SECONDS=604800
# 上传侧让路阈值（%）：全局嵌入配额使用率高于该值时批量上传自动降速，前台检索优先
# KB_EMBEDDING_YIELD_PERCENT=70
# 图片逐张嵌入的本地并发度（服务商侧总并发仍由 EMBEDDING_GLOBAL_CONCURRENCY 约束）
# EMBEDDING_IMAGE_PARALLELISM=2

# 连接池（每进程/副本独立；多副本时按进程数核算 PostgreSQL max_connections）
# 同步池（工具/压缩/实验等线程路径）
# CHAT_DB_POOL_SIZE=5
# CHAT_DB_MAX_OVERFLOW=5
# CHAT_DB_POOL_TIMEOUT=10
# 异步池（对话链路；Windows Proactor 下自动退化为线程池）
# CHAT_DB_ASYNC_POOL_SIZE=10
# CHAT_DB_ASYNC_MAX_OVERFLOW=10
# TORTOISE_DB_POOL_MINSIZE=2
# TORTOISE_DB_POOL_MAXSIZE=10
# REDIS_MAX_CONNECTIONS=64

# 对外 API 根地址（无尾斜杠），用于知识库检索工具生成图片完整 URL，便于模型 Markdown 展示；示例: http://127.0.0.1:8000
PUBLIC_API_BASE=http://127.0.0.1:9999

# ===== 一键部署（docker-compose.prod.yml，可选）=====
# 浏览器访问端口，默认 8088
# WEB_PORT=8088
# 公网站点根地址（含协议、无尾斜杠）。同机 Docker 访问可留空，走相对路径
# PROD_PUBLIC_API_BASE=https://your.domain

# ===== Web Search（联网搜索）=====
# provider: auto / ddgs / bocha / bing_html
# auto：无代理且已配博查 Key 时 bocha → bing_html；有代理时 ddgs → bocha → bing_html
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_MAX_RESULTS=8
# ddgs 格式 {country}-{language}；旧值 zh-cn 会自动归一为 cn-zh
WEB_SEARCH_REGION=cn-zh
WEB_SEARCH_TIMEOUT_SECONDS=20
# 可选：ddgs / 博查 / bing_html 均使用，如 http://127.0.0.1:7890
# WEB_SEARCH_PROXY=
# 空=自动（无代理 bing / 有代理 auto）；也可强制指定，如 bing 或 google,brave,bing
# WEB_SEARCH_DDGS_BACKEND=
# 博查 Web Search（国内无代理主路径）。申请: https://open.bochaai.com/ → API KEY 管理
WEB_SEARCH_BOCHA_API_KEY=
WEB_SEARCH_BOCHA_ENDPOINT=https://api.bochaai.com/v1/web-search
# 召回条数（重排前，1–50）；最终交给模型的条数仍是 WEB_SEARCH_MAX_RESULTS
WEB_SEARCH_CANDIDATE_COUNT=30
# 时效：auto 按查询时间意图词映射；也可固定 noLimit / oneDay / oneWeek / oneMonth / oneYear
WEB_SEARCH_FRESHNESS=auto
# 博查 Semantic Reranker（复用上面的 BOCHA API KEY；无 Key 或 false 则跳过）
WEB_SEARCH_RERANK_ENABLED=true
WEB_SEARCH_RERANK_ENDPOINT=https://api.bochaai.com/v1/rerank
WEB_SEARCH_RERANK_MODEL=gte-rerank
WEB_SEARCH_RERANK_MIN_SCORE=0.35
WEB_SEARCH_RERANK_TIMEOUT_SECONDS=12
# 通用权威度软加权（结构信号 + 查询对齐；不维护站点白名单）
WEB_SEARCH_AUTHORITY_ENABLED=true
WEB_SEARCH_AUTHORITY_BLEND=0.35
# 有时间意图时 datePublished 软加权
WEB_SEARCH_RECENCY_BLEND=0.2
# 读页：对最终结果前 N 条抓取 HTML 主文（失败保留摘要）
WEB_SEARCH_READ_ENABLED=true
WEB_SEARCH_READ_TOP_N=5
WEB_SEARCH_READ_TIMEOUT_SECONDS=10
WEB_SEARCH_READ_MAX_BYTES=524288
WEB_SEARCH_READ_MAX_CHARS=3500
# fetch_url 独立配额与抽文长度
WEB_SEARCH_MAX_CALLS_PER_TURN=3
WEB_SEARCH_FETCH_MAX_CALLS_PER_TURN=4
WEB_SEARCH_FETCH_MAX_CHARS=6000
