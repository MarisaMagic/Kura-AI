# ===== Embedding Model =====
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
# 向量维度，须与 Milvus 集合 dense_embedding 维一致；v3/v4 会传给 DashScope dimensions
EMBEDDING_DIM=1024
# 嵌入 API 每批条数（v4≤10，v2≤25；超出易 400）
EMBEDDING_BATCH_SIZE=10

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=embeddings_kb_1024

# ===== Database / Cache =====
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/langchain_app
REDIS_URL=redis://127.0.0.1:6379/0